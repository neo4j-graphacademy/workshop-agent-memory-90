# Copy the values from the "Your workshop instance" panel in the course,
# right here - do not rename this file or move it. create-context-graph
# reads Aura credentials from a file in exactly this format, and later
# tasks point it straight at this one.
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password-here
NEO4J_DATABASE=neo4j

# Your OpenAI key, once here, is all this workshop needs -- Copilot's own
# memory MCP server (task 6) reads it straight from this file, and
# configure-app.py copies all three lines into the generated app's own
# .env for you (task 2). No need to paste any of these a second time.
OPENAI_API_KEY=sk-...
MEMORY_EMBEDDING=openai/text-embedding-3-small

# The openai-agents SDK reads this env var directly (OPENAI_DEFAULT_MODEL)
# for any Agent built without an explicit model= - which is every agent
# this workshop builds, generated or hand-written. Leave it as-is.
OPENAI_DEFAULT_MODEL=gpt-5.6-terra
